# 对话模型（第 1~9 课都用它）
# 旧模型名 deepseek-chat / deepseek-reasoner 已于 2026-07-24 停用，
# 现在只有 deepseek-flash（快、便宜）和 deepseek-v4-pro（强、贵）。
# 两个模型的量级一样：上下文长度 1M，单次输出上限 384K。
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 第 4 课：上下文预算，调小可以强制看到摘要压缩发生
# TOKEN_BUDGET=300

# 嵌入模型（第 5 课 RAG）
# DeepSeek 没有 embedding 接口，这里用硅基流动的 BAAI/bge-m3。
# 注意 base_url 带 /v1，和上面的 DeepSeek 不一样。
SILICONFLOW_API_KEY=sk-xxxxxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
